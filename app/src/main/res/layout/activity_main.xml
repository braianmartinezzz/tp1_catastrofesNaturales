<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btn_flash"
        android:layout_width="143dp"
        android:layout_height="155dp"
        android:text="FLASH"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_clima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#2196F3"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_ciudad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General Pico"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_temperatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°C"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_ciudad"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_icono_clima"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="48sp"
                app:layout_constraintTop_toTopOf="@id/tv_temperatura"
                app:layout_constraintBottom_toBottomOf="@id/tv_temperatura"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_detalles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viento: -- km/h | Humedad: --%"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tv_temperatura"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botón principal que abre/cierra la lista -->

    <!-- Contenedor de botones (Arranca invisible: visibility="gone") -->

    <Button
        android:id="@+id/btn_desplegar_emergencias"
        android:layout_width="95dp"
        android:layout_height="71dp"
        android:layout_marginHorizontal="16dp"
        android:text="emergencia"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.079"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="488dp"

        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="480dp"

        />

    <LinearLayout
        android:id="@+id/contenedor_emergencias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_desplegar_emergencias"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Aquí aparecerán los botones mágicamente desde Kotlin -->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>