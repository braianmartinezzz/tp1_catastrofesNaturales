<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_gradient"
    android:textColor="#FFFFFF"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Barra superior personalizada -->
    <LinearLayout
        android:id="@+id/barra_superior_custom"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2A2A3E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CATASTROFES APP"
            android:textColor="#FF7E67"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tv_reloj_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:27 AM"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:backgroundTint="#FF7E67"
        android:textColor="#FFFFFF"
        android:id="@+id/btn_flash"
        android:layout_width="200dp"
        android:layout_height="155dp"
        app:icon="@drawable/ic_linterna"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconSize="80dp"
        app:iconPadding="0dp"
        android:padding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:contentDescription="Botón para encender la linterna"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_clima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#2A2A3E"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/barra_superior_custom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_ciudad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GENERAL PICO"
                android:textColor="#FF7E67"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_temperatura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°C"
                android:textColor="#FFFFFF"
                android:textSize="56sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_ciudad"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_icono_clima"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="56sp"
                app:layout_constraintTop_toTopOf="@id/tv_temperatura"
                app:layout_constraintBottom_toBottomOf="@id/tv_temperatura"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_detalles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viento: -- km/h  |  Humedad: --%"
                android:textColor="#A0A0B5"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_temperatura"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:backgroundTint="#3B3B54"
        android:textColor="#FF7E67"
        android:id="@+id/btn_ir_mapa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="VER MAPA Y UBICACIÓN"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_clima" />

    <!-- Botón principal que abre/cierra la lista -->

    <!-- Contenedor de botones (Arranca invisible: visibility="gone") -->

    <Button
        android:id="@+id/btn_desplegar_emergencias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="480dp"
        android:backgroundTint="#3B3B54"
        app:icon="@drawable/icono_telefono_asistencia"
        app:iconTint="#FF7E67"
        app:iconSize="48dp"
        android:padding="16dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:cornerRadius="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.079"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Botón de emergencias" />

    <!-- Botón único que abrirá el menú de grabaciones -->
    <Button
        android:id="@+id/btn_menu_grabacion"
        android:layout_width="128dp"
        android:layout_height="122dp"
        android:layout_marginHorizontal="16dp"
        android:backgroundTint="#3B3B54"
        android:contentDescription="Guardar video o audio"
        android:padding="0dp"
        app:icon="@drawable/round_bookmark_add_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="45dp"
        app:iconTint="#FF7E67"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_flash"
        app:layout_constraintVertical_bias="0.176" />

    <Button
        android:id="@+id/button"
        android:layout_width="89dp"
        android:layout_height="87dp"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.288"
        app:layout_constraintStart_toEndOf="@+id/btn_menu_grabacion"
        app:layout_constraintTop_toBottomOf="@+id/btn_flash"
        app:layout_constraintVertical_bias="0.184" />

    <Button
        android:id="@+id/button4"
        android:layout_width="89dp"
        android:layout_height="87dp"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.288"
        app:layout_constraintStart_toEndOf="@+id/btn_menu_grabacion"
        app:layout_constraintTop_toBottomOf="@+id/btn_flash"
        app:layout_constraintVertical_bias="0.766" />

    <Button
        android:id="@+id/button3"
        android:layout_width="87dp"
        android:layout_height="89dp"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.123"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_menu_grabacion"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/button5"
        android:layout_width="128dp"
        android:layout_height="96dp"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button4"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/button3"
        app:layout_constraintTop_toBottomOf="@+id/btn_menu_grabacion"
        app:layout_constraintVertical_bias="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>