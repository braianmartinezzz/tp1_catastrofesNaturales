<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#2A2A3E"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_titulo_grabacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="OPCIONES DE GRABACIÓN"
            android:textColor="#FF7E67"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:background="#3B3B54" />

        <!-- Opción 1: Cámara Trasera -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grabar_trasera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="14dp"
            android:text="Cámara Trasera"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#3B3B54"
            app:cornerRadius="16dp"
            app:rippleColor="#FF7E67" />

        <!-- Opción 2: Cámara Selfie -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grabar_selfie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingVertical="14dp"
            android:text="Cámara Frontal"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#3B3B54"
            app:cornerRadius="16dp"
            app:rippleColor="#FF7E67" />

        <!-- Botón Cerrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cerrar_dialogo"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="CANCELAR"
            android:textColor="#A0A0B5"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
